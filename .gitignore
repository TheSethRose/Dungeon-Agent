# ===========================================================================
# Dungeon-Agent distribution .gitignore
# This is a SHAREABLE distribution repo. It ships the agent CONTENT
# (SOUL, config, skills, engine) but NEVER secrets or user data.
# ===========================================================================

# --- Credentials & secrets — NEVER commit ---
auth.json
.env
.env.EXAMPLE
*.pem
*.key

# --- Runtime databases & state ---
state.db
state.db-shm
state.db-wal
hermes_state.db
response_store.db
response_store.db-shm
response_store.db-wal
gateway.pid
gateway_state.json
processes.json
auth.lock
active_profile
.update_check
verification_evidence.db

# --- User data — NEVER commit ---
memories/
sessions/
logs/
plans/
home/

# workspace/ is user data per Hermes convention — never ship it.
# (The engine lives in dungeons/, NOT workspace/.)
workspace/

# --- Game runtime state (user/character data, not distribution content) ---
# Saves live inside campaign folders (e.g. skills/campaigns/<name>/saves/)
# and are portable WITH the campaign — but they are USER progress, not
# distribution content, so we do NOT ship them in this share repo.
dungeons/saves/
**/saves/

# --- Skills: ship the curated SKILL.md + references, not internal state ---
skills/.curator_state
skills/.usage.json
skills/.usage.json.lock

# --- Local profile setup marker (installer concern, not distribution content) ---
.no-bundled-skills

# --- Caches & generated artifacts ---
image_cache/
audio_cache/
document_cache/
browser_screenshots/
cache/
models_dev_cache.json
provider_models_cache.json
ollama_cloud_models_cache.json
node_modules/
models/
.data/

# --- Infrastructure ---
bin/
sandboxes/

# --- User customization namespace ---
local/

# --- Checkpoints & backups ---
checkpoints/
backups/

# --- Logs & history ---
*.log
.hermes_history

# --- OS junk ---
.DS_Store
Thumbs.db
